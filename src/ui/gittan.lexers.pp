unit gittan.lexers;

{** Syntax highlighting library for Gittan.

  Loads every EControl lexer (*.lcf) from one folder and picks a lexer for a
  file name. The folder is generated by `make lexlib` from the vendored
  CudaText-lexers collection, which keeps one subfolder per lexer. The
  lexers' own colors are replaced by a syntax theme (gittan.syntaxthemes),
  through the style mapping of each lexer's .cuda-lexmap file. The lexers
  load in a thread of their own, so startup does not wait for them. }

{$mode objfpc}{$H+}

interface

uses
  Classes, SysUtils,
  ec_SyntAnal, ec_LexerList, ec_syntax_format, LCLType, Graphics;

type
  {** Owns the lexer list and knows where the lexer files live. }
  TGittanLexers = class
  private
    FList: TecLexerList;
    FFolder: string;
    FErrors: string;
    FOriginal: array of TColor;
    FOriginalStyle: array of TFontStyles;
    FChooseDir: string;
    FThread: TThread;
    FOnLoaded: TNotifyEvent;
    FThemeSet, FThemeDark: boolean;
    FTheme: integer;
    procedure LoadLibrary;
    procedure Finish;
    function GetErrors: string;
    procedure NormalizeStyles;
    function ChooseLexer(const AFileName: string; ALexers: TStringList): integer;
  public
    constructor Create;
    destructor Destroy; override;
    {** Starts loading all lexers from the first folder that exists, in a
      thread, and normalizes their styles there: background colors are
      dropped so only the diff colors paint line backgrounds, and system
      font colors become "none" so the editor's own text color is used.
      Returns false when no lexer folder was found. A call that needs the
      lexers before they are loaded waits for the rest; OnLoaded tells
      when they are in. }
    function Load: boolean;
    {** True once the lexers are loaded, or when there was nothing to
      load. Does not wait. }
    function Loaded: boolean;
    {** Whether any lexer was loaded. Waits for the load. }
    function HasLexers: boolean;
    {** Sets every lexer's text colors for a dark or a light editor from
      the syntax theme ATheme (an index into SyntaxThemes): a style that
      the lexer's .cuda-lexmap maps to a theme style gets the theme's color
      and font style; any other keeps the color from the lexer file for
      light, lightened with LightenForDark for dark. Can be called again
      when the desktop theme or the chosen theme changes. While the lexers
      load it is remembered and applied when they are in. }
    procedure ApplyTheme(ADark: boolean; ATheme: integer);
    {** The lexer for a file name, or nil for plain text. An extension
      several lexers claim is settled by the files beside it (see
      gittan.lexerpick); a relative name is taken under ARoot. }
    function ForFile(const AFileName: string; const ARoot: string = ''): TecSyntAnalyzer;
    {** The lexer with this exact name, or nil. }
    function ByName(const AName: string): TecSyntAnalyzer;
    {** Names of all loaded, non-internal lexers, sorted. }
    procedure GetNames(AList: TStrings);
    property Folder: string read FFolder;
    {** Lexer files that could not be read and sub-lexer links that could
      not be resolved, one per line. Waits for the load. }
    property Errors: string read GetErrors;
    {** Called in the main thread once the lexers are loaded, from the
      message loop or from the call that waited for them. }
    property OnLoaded: TNotifyEvent read FOnLoaded write FOnLoaded;
  end;

{** Candidate lexer folders, in search order. }
function LexerFolderCandidates: TStringArray;

implementation

uses
  Forms, LazFileUtils, gittan.theme, gittan.lexerpick, gittan.syntaxthemes,
  gittan.git;

const
  { How many sibling files are looked at to settle an ambiguous extension. }
  MaxSiblings = 500;

{ A theme color as an LCL color; NoColor leaves the editor's text color. }
function ThemeColor(AValue: cardinal): TColor;
begin
  if AValue = NoColor then
    Result := clNone
  else
    Result := RGBToColor((AValue shr 16) and $FF, (AValue shr 8) and $FF,
      AValue and $FF);
end;

{ ---------------------------------------------------------------------------
  Lexer folder lookup
  ---------------------------------------------------------------------------
  GITTAN_LEXLIB overrides everything. Otherwise look beside the executable,
  in a macOS bundle's Resources, and in the project root when the executable
  runs from the Gittan.app wrapper the IDE makes there. }
function LexerFolderCandidates: TStringArray;
var
  ExeDir, Env: string;
begin
  Result := nil;
  ExeDir := ExtractFilePath(Application.ExeName);
  Env := EnvironmentVariable('GITTAN_LEXLIB');
  if Env <> '' then
    Result := Concat(Result, [Env]);
  Result := Concat(Result, [
    ExeDir + 'lexlib',
    ExeDir + '../Resources/lexlib',
    ExeDir + '../../../lexlib']);
end;

{ ---------------------------------------------------------------------------
  Load errors
  ---------------------------------------------------------------------------
  TecLexerList reports a broken lexer file through a plain procedure, so the
  message is collected in a unit variable and copied out after loading. }
var
  LoadErrors: string = '';

procedure CollectLoadError(const AFileName, AError: string);
begin
  LoadErrors += Format('%s: %s'#10, [ExtractFileName(AFileName), AError]);
end;

{ ---------------------------------------------------------------------------
  Loading thread
  ---------------------------------------------------------------------------
  Reading 700-odd lexer files takes a while (most on Windows, where every
  file is scanned as it opens), so it runs beside the main thread, which
  does not touch the lexer list until the thread is done (CudaText used to
  load its lexers in a thread too). }
type
  TLoadThread = class(TThread)
  private
    FLexers: TGittanLexers;
  protected
    procedure Execute; override;
  public
    constructor Create(ALexers: TGittanLexers);
  end;

constructor TLoadThread.Create(ALexers: TGittanLexers);
begin
  FLexers := ALexers;
  inherited Create(False);
end;

procedure TLoadThread.Execute;
begin
  FLexers.LoadLibrary;
  Queue(@FLexers.Finish);
end;

{ TGittanLexers }

constructor TGittanLexers.Create;
begin
  inherited Create;
  FList := TecLexerList.Create(nil);
  FList.OnLexerLoadError := @CollectLoadError;
end;

destructor TGittanLexers.Destroy;
begin
  if FThread <> nil then
  begin
    FThread.WaitFor;
    FreeAndNil(FThread);
  end;
  FreeAndNil(FList);
  inherited Destroy;
end;

function TGittanLexers.Load: boolean;
var
  Dir: string;
begin
  Result := False;
  FErrors := '';
  for Dir in LexerFolderCandidates do
    if DirectoryExists(Dir) then
    begin
      FFolder := ExpandFileName(Dir);
      FThread := TLoadThread.Create(Self);
      Exit(True);
    end;
end;

{ In the loading thread. }
procedure TGittanLexers.LoadLibrary;
var
  LinkErrors: string;
begin
  LoadErrors := '';
  FList.InitLibrary(FFolder, LinkErrors);
  FErrors := LoadErrors + LinkErrors;
  NormalizeStyles;
end;

{ Queued by the thread when it is done, and called by everything that
  needs the lexers: waits for the thread, applies the theme asked for
  meanwhile and tells the owner. FThread is cleared first: WaitFor runs
  the queued call in the main thread, which must find the load finished. }
procedure TGittanLexers.Finish;
var
  T: TThread;
begin
  if FThread = nil then
    Exit;
  T := FThread;
  FThread := nil;
  T.WaitFor;
  T.Free;
  if FThemeSet then
    ApplyTheme(FThemeDark, FTheme);
  if Assigned(FOnLoaded) then
    FOnLoaded(Self);
end;

function TGittanLexers.Loaded: boolean;
begin
  Result := FThread = nil;
end;

function TGittanLexers.HasLexers: boolean;
begin
  Finish;
  Result := FList.LexerCount > 0;
end;

function TGittanLexers.GetErrors: string;
begin
  Finish;
  Result := FErrors;
end;

{ Lexer styles may carry a background (Markdown code blocks, for example);
  Gittan uses the line background for the diff, so every style is reduced to
  its font and foreground color. Some lexers also use system colors such as
  clWindowText for text, which the widgetset resolves to white in a dark
  desktop theme while the editor keeps its light background; those colors
  are dropped so the editor's text color applies. The colors and font styles
  that remain are remembered for the styles the theme does not cover. }
procedure TGittanLexers.NormalizeStyles;
var
  i, j, n: integer;
  An: TecSyntAnalyzer;
  Fmt: TecSyntaxFormat;
begin
  n := 0;
  for i := 0 to FList.LexerCount - 1 do
    Inc(n, FList.Lexers[i].Formats.Count);
  SetLength(FOriginal, n);
  SetLength(FOriginalStyle, n);
  n := 0;
  for i := 0 to FList.LexerCount - 1 do
  begin
    An := FList.Lexers[i];
    for j := 0 to An.Formats.Count - 1 do
    begin
      Fmt := An.Formats[j];
      Fmt.BgColor := clNone;
      if (Fmt.Font <> nil) and ((Fmt.Font.Color and SYS_COLOR_BASE) <> 0) then
        Fmt.Font.Color := clNone;
      if Fmt.Font <> nil then
      begin
        FOriginal[n] := Fmt.Font.Color;
        FOriginalStyle[n] := Fmt.Font.Style;
      end
      else
      begin
        FOriginal[n] := clNone;
        FOriginalStyle[n] := [];
      end;
      Inc(n);
    end;
  end;
end;

{ The formats are visited in the same order as in NormalizeStyles, so the
  remembered colors line up. A style the lexmap maps to a theme style takes
  the theme's color and font style; a style without a mapping (or mapped to
  "-", which CudaText uses for "no theme style") keeps the lexer's own. }
procedure TGittanLexers.ApplyTheme(ADark: boolean; ATheme: integer);
var
  i, j, n: integer;
  An: TecSyntAnalyzer;
  Fmt: TecSyntaxFormat;
  Color: cardinal;
  Style: TThemeFontStyles;
begin
  FThemeSet := True;
  FThemeDark := ADark;
  FTheme := ATheme;
  if FThread <> nil then
    Exit;
  n := 0;
  for i := 0 to FList.LexerCount - 1 do
  begin
    An := FList.Lexers[i];
    for j := 0 to An.Formats.Count - 1 do
    begin
      Fmt := An.Formats[j];
      if Fmt.Font <> nil then
      begin
        if SyntaxThemeStyle(ATheme, An.ThemeMappingOfStyle(Fmt.DisplayName),
          ADark, Color, Style) then
        begin
          Fmt.Font.Color := ThemeColor(Color);
          Fmt.Font.Style := [];
          if tfsBold in Style then
            Fmt.Font.Style := Fmt.Font.Style + [fsBold];
          if tfsItalic in Style then
            Fmt.Font.Style := Fmt.Font.Style + [fsItalic];
          if tfsStrikeOut in Style then
            Fmt.Font.Style := Fmt.Font.Style + [fsStrikeOut];
        end
        else
        begin
          if ADark then
            Fmt.Font.Color := LightenForDark(FOriginal[n])
          else
            Fmt.Font.Color := FOriginal[n];
          Fmt.Font.Style := FOriginalStyle[n];
        end;
      end;
      Inc(n);
    end;
  end;
end;

function TGittanLexers.ForFile(const AFileName: string; const ARoot: string): TecSyntAnalyzer;
begin
  Finish;
  FChooseDir := ExtractFilePath(AFileName);
  if (ARoot <> '') and not FilenameIsAbsolute(AFileName) then
    FChooseDir := IncludeTrailingPathDelimiter(ARoot) + FChooseDir;
  Result := FList.FindLexerByFilename(AFileName, @ChooseLexer);
end;

{ The lexer list's choice among the lexers that claim the file's
  extension (ALexers, sorted by name): the lexers of the files beside it
  (in FChooseDir, set by ForFile) vote, then the preference table has a
  say, else the first is taken. A sibling with an ambiguous extension of
  its own gets the first lexer in name order; its vote is as good as any. }
function TGittanLexers.ChooseLexer(const AFileName: string; ALexers: TStringList): integer;
var
  Exts, Votes: TStringList;
  Ext: string;
  An: TecSyntAnalyzer;
  i: integer;
begin
  Exts := TStringList.Create;
  Votes := TStringList.Create;
  try
    Ext := LowerCase(ExtractFileExt(AFileName));
    Delete(Ext, 1, 1);
    SiblingExtensions(FChooseDir, Ext, Exts, MaxSiblings);
    for i := 0 to Exts.Count - 1 do
    begin
      An := FList.FindLexerByFilename('x.' + Exts[i], nil);
      if An <> nil then
        Votes.Add(An.LexerName);
    end;
    Result := MostVoted(Votes, ALexers);
    if Result < 0 then
      Result := ALexers.IndexOf(PreferredLexer(Ext));
    { EControl takes -1 for no lexer at all, not for its own choice. }
    if Result < 0 then
      Result := 0;
  finally
    Exts.Free;
    Votes.Free;
  end;
end;

function TGittanLexers.ByName(const AName: string): TecSyntAnalyzer;
begin
  Finish;
  Result := FList.FindLexerByName(AName);
end;

procedure TGittanLexers.GetNames(AList: TStrings);
var
  i: integer;
  An: TecSyntAnalyzer;
begin
  Finish;
  AList.Clear;
  for i := 0 to FList.LexerCount - 1 do
  begin
    An := FList.Lexers[i];
    if An.Deleted or An.Internal then
      Continue;
    AList.Add(An.LexerName);
  end;
  if AList is TStringList then
    TStringList(AList).Sort;
end;

end.
