# Lazarus compiler-generated binaries (safe to delete)
*.exe
*.dll
*.so
*.so.[0-9]*
*.dylib
*.lrs
*.res
*.compiled
*.dbg
*.ppu
*.o
*.or
*.a

# Lazarus autogenerated files (duplicated info)
*.rst
*.rsj
*.lrt

# Lazarus local files (user-specific info)
*.lps

# Lazarus backups and unit output folders.
# These can be changed by user in Lazarus/project options.
backup/
*.bak
lib/

# Linker leftovers from failed or interrupted links
link*.res
symbol_order*.fpc

# Application bundle for Mac OS
*.app/

/Gittan
/build/
*.dmg
*.zip
*.tmp
*.trc
.tmp

# Vi temps
.gitignore~
..gitignore.un~

# macOS Finder metadata
.DS_Store

# Lexer library generated by make lexlib
/lexlib/

# Test build output from make test
/tests/lib/
/tests/gittantests

# Linux packages (make packages)
pkg/
