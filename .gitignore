# Lazarus compiler-generated binaries (safe to delete)
*.exe
*.dll
*.so
*.so.[0-9]*
*.dylib
# The prebuilt QuickJS engine and shim the extensions link are kept
# (externals/quickjs/README.md).
!/externals/quickjs/prebuilt/**
# but not the links make (qjs-links) puts beside the Linux engine
/externals/quickjs/prebuilt/*/libqjs.so
/externals/quickjs/prebuilt/*/libqjs.so.0
*.lrs
*.res
*.compiled
*.dbg
*.ppu
*.o
*.or
*.a

# Lazarus autogenerated files (duplicated info)
*.rst
*.rsj
*.lrt

# Lazarus local files (user-specific info)
*.lps

# Lazarus backups and unit output folders.
# These can be changed by user in Lazarus/project options.
backup/
*.bak
lib/

# Linker leftovers from failed or interrupted links
link*.res
symbol_order*.fpc

# Application bundle for Mac OS
*.app/

/Gittan
/build/
*.dmg
*.zip
*.tmp
*.trc
.tmp

# Vi temps
.gitignore~
..gitignore.un~

# macOS Finder metadata
.DS_Store

# Lexer library generated by make lexlib
/lexlib/

# Test build output from make test
/tests/lib/
/tests/gittantests

# Linux packages (make packages)
pkg/

# Commits of the packages the Lazarus IDE was last built with (make ide)
/.ide-vendor
