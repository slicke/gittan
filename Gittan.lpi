        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src/gittan.welcome.pp"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src/gittan.popuplist.pp"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src/gittan.hoverpills.pp"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src/gittan.notice.pp"/>
        <IsPartOfProject Value="True"/>
