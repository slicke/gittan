      <Unit>
        <Filename Value="src/gittan.banner.pp"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src/gittan.keep.pp"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src/gittan.statusbar.pp"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src/gittan.fileheader.pp"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
