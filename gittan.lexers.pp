unit gittan.lexers;

{** Syntax highlighting library for Gittan.

  Loads every EControl lexer (*.lcf) from one folder and picks a lexer for a
  file name. The folder is generated by `make lexlib` from the vendored
  CudaText-lexers collection, which keeps one subfolder per lexer. The
  lexers' own colors are replaced by a syntax theme in the style of VS Code,
  through the style mapping of each lexer's .cuda-lexmap file. }

{$mode objfpc}{$H+}

interface

uses
  Classes, SysUtils,
  ec_SyntAnal, ec_LexerList, ec_syntax_format, LCLType, Graphics;

type
  {** Owns the lexer list and knows where the lexer files live. }
  TGittanLexers = class
  private
    FList: TecLexerList;
    FFolder: string;
    FErrors: string;
    FOriginal: array of TColor;
    FOriginalStyle: array of TFontStyles;
    FChooseDir: string;
    procedure NormalizeStyles;
    function ChooseLexer(const AFileName: string; ALexers: TStringList): integer;
  public
    constructor Create;
    destructor Destroy; override;
    {** Loads all lexers from the first folder that exists and normalizes
      their styles: background colors are dropped so only the diff colors
      paint line backgrounds, and system font colors become "none" so the
      editor's own text color is used. Returns false when no lexer folder
      was found. }
    function Load: boolean;
    {** Sets every lexer's text colors for a dark or a light editor from the
      syntax theme: a style that the lexer's .cuda-lexmap maps to a theme
      style gets the theme's color and font style; any other keeps the
      color from the lexer file for light, lightened with LightenForDark
      for dark. Can be called again when the desktop theme changes. }
    procedure ApplyTheme(ADark: boolean);
    {** The lexer for a file name, or nil for plain text. An extension
      several lexers claim is settled by the files beside it (see
      gittan.lexerpick); a relative name is taken under ARoot. }
    function ForFile(const AFileName: string; const ARoot: string = ''): TecSyntAnalyzer;
    {** The lexer with this exact name, or nil. }
    function ByName(const AName: string): TecSyntAnalyzer;
    {** Names of all loaded, non-internal lexers, sorted. }
    procedure GetNames(AList: TStrings);
    property Folder: string read FFolder;
    {** Sub-lexer links that could not be resolved, one per line. }
    property Errors: string read FErrors;
  end;

{** Candidate lexer folders, in search order. }
function LexerFolderCandidates: TStringArray;

implementation

uses
  Forms, LazFileUtils, gittan.theme, gittan.lexerpick;

const
  { How many sibling files are looked at to settle an ambiguous extension. }
  MaxSiblings = 500;

{ ---------------------------------------------------------------------------
  Syntax theme
  ---------------------------------------------------------------------------
  CudaText names its theme styles (Id, IdKeyword, String, Comment, ...) and
  every lexer's .cuda-lexmap maps the lexer's own style names to them, so
  one palette colors all lexers alike. The colors are VS Code's Light+ and
  Dark+ token colors. NoColor leaves the editor's text color in place. The
  background styles (BracketBG, SectionBG1, ...) are not listed: Gittan
  paints no style backgrounds. }
const
  NoColor = $FFFFFFFF;

type
  TThemeStyle = record
    Name: string;
    Light, Dark: cardinal; // $RRGGBB
    Style: TFontStyles;
  end;

const
  ThemeStyles: array[0..34] of TThemeStyle = (
    (Name: 'Id'; Light: NoColor; Dark: NoColor; Style: []),
    (Name: 'Id1'; Light: $001080; Dark: $9CDCFE; Style: []),
    (Name: 'Id2'; Light: $267F99; Dark: $4EC9B0; Style: []),
    (Name: 'Id3'; Light: $795E26; Dark: $DCDCAA; Style: []),
    (Name: 'Id4'; Light: $0070C1; Dark: $4FC1FF; Style: []),
    (Name: 'IdKeyword'; Light: $0000FF; Dark: $569CD6; Style: []),
    (Name: 'IdVar'; Light: $001080; Dark: $9CDCFE; Style: []),
    (Name: 'IdBad'; Light: $CD3131; Dark: $F44747; Style: []),
    (Name: 'String'; Light: $A31515; Dark: $CE9178; Style: []),
    (Name: 'String2'; Light: $811F3F; Dark: $D16969; Style: []),
    (Name: 'String3'; Light: $A31515; Dark: $CE9178; Style: []),
    (Name: 'Symbol'; Light: NoColor; Dark: NoColor; Style: []),
    (Name: 'Symbol2'; Light: $AF00DB; Dark: $C586C0; Style: []),
    (Name: 'SymbolBad'; Light: $CD3131; Dark: $F44747; Style: []),
    (Name: 'Comment'; Light: $008000; Dark: $6A9955; Style: []),
    (Name: 'Comment2'; Light: $AF00DB; Dark: $C586C0; Style: []),
    (Name: 'CommentDoc'; Light: $008000; Dark: $6A9955; Style: []),
    (Name: 'Number'; Light: $098658; Dark: $B5CEA8; Style: []),
    (Name: 'Label'; Light: $795E26; Dark: $DCDCAA; Style: []),
    (Name: 'Color'; Light: $0451A5; Dark: $CE9178; Style: []),
    (Name: 'TagBound'; Light: $800000; Dark: $808080; Style: []),
    (Name: 'TagId'; Light: $800000; Dark: $569CD6; Style: []),
    (Name: 'TagIdBad'; Light: $CD3131; Dark: $F44747; Style: []),
    (Name: 'TagProp'; Light: $E50000; Dark: $9CDCFE; Style: []),
    (Name: 'TagPropBad'; Light: $CD3131; Dark: $F44747; Style: []),
    (Name: 'TagInclude'; Light: $AF00DB; Dark: $C586C0; Style: []),
    (Name: 'SeparLine'; Light: NoColor; Dark: NoColor; Style: []),
    (Name: 'TextBold'; Light: NoColor; Dark: NoColor; Style: [fsBold]),
    (Name: 'TextItalic'; Light: NoColor; Dark: NoColor; Style: [fsItalic]),
    (Name: 'TextBoldItalic'; Light: NoColor; Dark: NoColor;
      Style: [fsBold, fsItalic]),
    (Name: 'TextCross'; Light: NoColor; Dark: NoColor; Style: [fsStrikeOut]),
    (Name: 'TextCrossBold'; Light: NoColor; Dark: NoColor;
      Style: [fsStrikeOut, fsBold]),
    (Name: 'TextCrossItalic'; Light: NoColor; Dark: NoColor;
      Style: [fsStrikeOut, fsItalic]),
    (Name: 'TextCrossBoldItalic'; Light: NoColor; Dark: NoColor;
      Style: [fsStrikeOut, fsBold, fsItalic]),
    (Name: 'Keyword'; Light: $0000FF; Dark: $569CD6; Style: [])
  );

function FindThemeStyle(const AName: string): integer;
begin
  for Result := 0 to High(ThemeStyles) do
    if ThemeStyles[Result].Name = AName then
      Exit;
  Result := -1;
end;

function ThemeColor(AValue: cardinal): TColor;
begin
  if AValue = NoColor then
    Result := clNone
  else
    Result := RGBToColor((AValue shr 16) and $FF, (AValue shr 8) and $FF,
      AValue and $FF);
end;

{ ---------------------------------------------------------------------------
  Lexer folder lookup
  ---------------------------------------------------------------------------
  GITTAN_LEXLIB overrides everything. Otherwise look beside the executable,
  in a macOS bundle's Resources, and in the project root when the executable
  runs from the Gittan.app wrapper the IDE makes there. }
function LexerFolderCandidates: TStringArray;
var
  ExeDir, Env: string;
begin
  Result := nil;
  ExeDir := ExtractFilePath(Application.ExeName);
  Env := GetEnvironmentVariable('GITTAN_LEXLIB');
  if Env <> '' then
    Result := Concat(Result, [Env]);
  Result := Concat(Result, [
    ExeDir + 'lexlib',
    ExeDir + '../Resources/lexlib',
    ExeDir + '../../../lexlib']);
end;

{ ---------------------------------------------------------------------------
  Load errors
  ---------------------------------------------------------------------------
  TecLexerList reports a broken lexer file through a plain procedure, so the
  message is collected in a unit variable and copied out after loading. }
var
  LoadErrors: string = '';

procedure CollectLoadError(const AFileName, AError: string);
begin
  LoadErrors += Format('%s: %s'#10, [ExtractFileName(AFileName), AError]);
end;

{ TGittanLexers }

constructor TGittanLexers.Create;
begin
  inherited Create;
  FList := TecLexerList.Create(nil);
  FList.OnLexerLoadError := @CollectLoadError;
end;

destructor TGittanLexers.Destroy;
begin
  FreeAndNil(FList);
  inherited Destroy;
end;

function TGittanLexers.Load: boolean;
var
  Dir, LinkErrors: string;
begin
  Result := False;
  FErrors := '';
  for Dir in LexerFolderCandidates do
    if DirectoryExists(Dir) then
    begin
      FFolder := ExpandFileName(Dir);
      LoadErrors := '';
      FList.InitLibrary(FFolder, LinkErrors);
      FErrors := LoadErrors + LinkErrors;
      NormalizeStyles;
      Exit(FList.LexerCount > 0);
    end;
end;

{ Lexer styles may carry a background (Markdown code blocks, for example);
  Gittan uses the line background for the diff, so every style is reduced to
  its font and foreground color. Some lexers also use system colors such as
  clWindowText for text, which the widgetset resolves to white in a dark
  desktop theme while the editor keeps its light background; those colors
  are dropped so the editor's text color applies. The colors and font styles
  that remain are remembered for the styles the theme does not cover. }
procedure TGittanLexers.NormalizeStyles;
var
  i, j, n: integer;
  An: TecSyntAnalyzer;
  Fmt: TecSyntaxFormat;
begin
  n := 0;
  for i := 0 to FList.LexerCount - 1 do
    Inc(n, FList.Lexers[i].Formats.Count);
  SetLength(FOriginal, n);
  SetLength(FOriginalStyle, n);
  n := 0;
  for i := 0 to FList.LexerCount - 1 do
  begin
    An := FList.Lexers[i];
    for j := 0 to An.Formats.Count - 1 do
    begin
      Fmt := An.Formats[j];
      Fmt.BgColor := clNone;
      if (Fmt.Font <> nil) and ((Fmt.Font.Color and SYS_COLOR_BASE) <> 0) then
        Fmt.Font.Color := clNone;
      if Fmt.Font <> nil then
      begin
        FOriginal[n] := Fmt.Font.Color;
        FOriginalStyle[n] := Fmt.Font.Style;
      end
      else
      begin
        FOriginal[n] := clNone;
        FOriginalStyle[n] := [];
      end;
      Inc(n);
    end;
  end;
end;

{ The formats are visited in the same order as in NormalizeStyles, so the
  remembered colors line up. A style the lexmap maps to a theme style takes
  the theme's color and font style; a style without a mapping (or mapped to
  "-", which CudaText uses for "no theme style") keeps the lexer's own. }
procedure TGittanLexers.ApplyTheme(ADark: boolean);
var
  i, j, n, t: integer;
  An: TecSyntAnalyzer;
  Fmt: TecSyntaxFormat;
begin
  n := 0;
  for i := 0 to FList.LexerCount - 1 do
  begin
    An := FList.Lexers[i];
    for j := 0 to An.Formats.Count - 1 do
    begin
      Fmt := An.Formats[j];
      if Fmt.Font <> nil then
      begin
        t := FindThemeStyle(An.ThemeMappingOfStyle(Fmt.DisplayName));
        if t >= 0 then
        begin
          if ADark then
            Fmt.Font.Color := ThemeColor(ThemeStyles[t].Dark)
          else
            Fmt.Font.Color := ThemeColor(ThemeStyles[t].Light);
          Fmt.Font.Style := ThemeStyles[t].Style;
        end
        else
        begin
          if ADark then
            Fmt.Font.Color := LightenForDark(FOriginal[n])
          else
            Fmt.Font.Color := FOriginal[n];
          Fmt.Font.Style := FOriginalStyle[n];
        end;
      end;
      Inc(n);
    end;
  end;
end;

function TGittanLexers.ForFile(const AFileName: string; const ARoot: string): TecSyntAnalyzer;
begin
  FChooseDir := ExtractFilePath(AFileName);
  if (ARoot <> '') and not FilenameIsAbsolute(AFileName) then
    FChooseDir := IncludeTrailingPathDelimiter(ARoot) + FChooseDir;
  Result := FList.FindLexerByFilename(AFileName, @ChooseLexer);
end;

{ The lexer list's choice among the lexers that claim the file's
  extension (ALexers, sorted by name): the lexers of the files beside it
  (in FChooseDir, set by ForFile) vote, then the preference table has a
  say, else the first is taken. A sibling with an ambiguous extension of
  its own gets the first lexer in name order; its vote is as good as any. }
function TGittanLexers.ChooseLexer(const AFileName: string; ALexers: TStringList): integer;
var
  Exts, Votes: TStringList;
  Ext: string;
  An: TecSyntAnalyzer;
  i: integer;
begin
  Exts := TStringList.Create;
  Votes := TStringList.Create;
  try
    Ext := LowerCase(ExtractFileExt(AFileName));
    Delete(Ext, 1, 1);
    SiblingExtensions(FChooseDir, Ext, Exts, MaxSiblings);
    for i := 0 to Exts.Count - 1 do
    begin
      An := FList.FindLexerByFilename('x.' + Exts[i], nil);
      if An <> nil then
        Votes.Add(An.LexerName);
    end;
    Result := MostVoted(Votes, ALexers);
    if Result < 0 then
      Result := ALexers.IndexOf(PreferredLexer(Ext));
  finally
    Exts.Free;
    Votes.Free;
  end;
end;

function TGittanLexers.ByName(const AName: string): TecSyntAnalyzer;
begin
  Result := FList.FindLexerByName(AName);
end;

procedure TGittanLexers.GetNames(AList: TStrings);
var
  i: integer;
  An: TecSyntAnalyzer;
begin
  AList.Clear;
  for i := 0 to FList.LexerCount - 1 do
  begin
    An := FList.Lexers[i];
    if An.Deleted or An.Internal then
      Continue;
    AList.Add(An.LexerName);
  end;
  if AList is TStringList then
    TStringList(AList).Sort;
end;

end.
