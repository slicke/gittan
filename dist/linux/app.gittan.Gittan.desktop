[Desktop Entry]
Type=Application
Name=Gittan
GenericName=Git Client
Comment=Browse, review and commit changes in a Git repository
Exec=/usr/bin/gittan %f
Icon=app.gittan.Gittan
Terminal=false
Categories=Development;RevisionControl;
